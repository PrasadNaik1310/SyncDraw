# Copy this file to .env (same folder) on the SERVER and fill in your key.
# Never commit .env.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.8-flash
# Used if GEMINI_MODEL stays overloaded (503) after retries.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Shared PIN for "Become Admin". Leave empty for one-click admin.
ADMIN_PIN=
